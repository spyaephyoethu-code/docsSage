# =============================================================================
# DocsSage — Root .env.example
# Copy this to .env and fill in your values.
# NEVER commit .env to git.
# =============================================================================

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>
# Postgres direct connection (used by backend for migrations/queries)
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# ── Groq ──────────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_<your-groq-api-key>

# ── Voyage AI (embeddings) ────────────────────────────────────────────────────
VOYAGE_API_KEY=pa-<your-voyage-api-key>

# ── Pinecone ──────────────────────────────────────────────────────────────────
PINECONE_API_KEY=<your-pinecone-api-key>
PINECONE_INDEX_NAME=docssage
PINECONE_ENVIRONMENT=us-east-1-aws   # or your chosen region

# ── Cohere (reranker) ─────────────────────────────────────────────────────────
COHERE_API_KEY=<your-cohere-api-key>

# ── Backend (FastAPI) ─────────────────────────────────────────────────────────
BACKEND_PORT=8000
ENVIRONMENT=development              # development | production
SECRET_KEY=<random-32-byte-hex>      # openssl rand -hex 32
ALLOWED_ORIGINS=http://localhost:3000,https://<your-vercel-domain>.vercel.app

# ── Frontend (Next.js) — prefixed with NEXT_PUBLIC_ to expose to browser ──────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>
NEXT_PUBLIC_API_URL=http://localhost:8000   # Railway URL in production

# ── Railway (set these in Railway dashboard, not here) ────────────────────────
# RAILWAY_TOKEN=<only needed for CLI deploys>
